#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: create-codespace <branch-name>"
  echo "Creates a GitHub Codespace for betterup/betterup-monolith and checks out the given branch."
  exit 1
fi

BRANCH="$1"
REPO="betterup/betterup-monolith"
MACHINE="largePremiumLinux"
DEVCONTAINER=".devcontainer/devcontainer.json"

# Try creating on the target branch first (works if branch exists on remote).
# Fall back to main and create the branch locally in the codespace.
echo "Creating Codespace on branch '$BRANCH'..."
if CODESPACE_NAME=$(gh codespace create \
  --repo "$REPO" \
  -b "$BRANCH" \
  --machine "$MACHINE" \
  --devcontainer-path "$DEVCONTAINER" 2>/dev/null); then
  echo "Codespace created: $CODESPACE_NAME"
else
  echo "Branch not found on remote, creating Codespace on main..."
  CODESPACE_NAME=$(gh codespace create \
    --repo "$REPO" \
    -b main \
    --machine "$MACHINE" \
    --devcontainer-path "$DEVCONTAINER")
  echo "Codespace created: $CODESPACE_NAME"
  echo "Pulling latest main..."
  gh codespace ssh -c "$CODESPACE_NAME" -- \
    "cd /workspaces/betterup-monolith && git pull origin main" || true
  echo "Creating local branch '$BRANCH'..."
  gh codespace ssh -c "$CODESPACE_NAME" -- \
    "cd /workspaces/betterup-monolith && git checkout -b '$BRANCH'" || true
fi

echo "Setting up dotfiles..."
gh codespace ssh -c "$CODESPACE_NAME" -- \
  "git clone https://github.com/dongkun0904/dotfiles /workspaces/dotfiles && cd /workspaces/dotfiles && bash install.sh" || true

echo "Connecting to Codespace..."
exec gh codespace ssh -c "$CODESPACE_NAME"
